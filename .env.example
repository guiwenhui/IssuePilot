# Browser-visible API address. This value is not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local PostgreSQL development database.
DATABASE_URL=postgresql+asyncpg://issuepilot:issuepilot@localhost:54329/issuepilot
TEST_DATABASE_URL=postgresql+asyncpg://issuepilot:issuepilot@localhost:54329/issuepilot_test
FRONTEND_ORIGIN=http://localhost:3000

# M2 repository clone safety limits. The workspace root must be an absolute,
# service-controlled directory and must not point at a source repository.
REPOSITORY_CLONE_ENABLED=true
REPOSITORY_WORKSPACE_ROOT=/tmp/issuepilot-workspaces
CLONE_TIMEOUT_SECONDS=60
MAX_WORKSPACE_BYTES=104857600
MAX_TRACKED_FILES=5000
MAX_TREE_ENTRIES=2000
MAX_TREE_DEPTH=25
CLONE_QUEUE_CAPACITY=20

# M3 Python AST parser limits. Repository code is read in an isolated parser
# process and is never imported or executed.
MAX_PYTHON_FILES=2000
MAX_PYTHON_FILE_BYTES=1048576
MAX_PYTHON_TOTAL_BYTES=20971520
MAX_CODE_ENTITIES=50000
PARSER_TIMEOUT_SECONDS=30
MAX_CODE_PREVIEW_ENTRIES=2000

# M4 local hybrid retrieval. Ollama stays on loopback and repository code is
# embedded locally; `truncate=false` makes oversized inputs fail explicitly.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
MAX_CODE_CHUNKS=10000
MAX_CHUNK_LINES=120
MAX_SYMBOL_CHUNK_LINES=160
CHUNK_OVERLAP_LINES=20
MAX_CHUNK_CHARACTERS=16384
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_RESULT_LIMIT=10

# M5 local-only structured planning. Code evidence is sent only to the Ollama
# loopback endpoint; remote LLM URLs are rejected by the provider.
PLANNING_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=180
LLM_CONTEXT_WINDOW=16384
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RESPONSE_BYTES=65536
PLANNING_EVIDENCE_LIMIT=10
PLANNING_MAX_SNIPPET_CHARACTERS=3000
PLANNING_MAX_EVIDENCE_CHARACTERS=20000
